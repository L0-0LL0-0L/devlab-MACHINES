# Copy to /etc/devlab/runner.env, chmod 0600. Never commit the filled file.
# App origin, e.g. https://devlab-machines.work
DEVLAB_URL=
# One-time runner credential shown after enrollment
DEVLAB_RUNNER_TOKEN=
# Path to the locally generated signing seed (from devlab_enroll.py keygen)
DEVLAB_SIGNING_KEY_FILE=/etc/devlab/signing.key
# Optional lower bounds
# DEVLAB_JOB_SECONDS=1000
# DEVLAB_MAX_ATTEMPTS=3
